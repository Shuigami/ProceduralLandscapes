#version 450

uniform vec3 color;
uniform vec3 sunDirection;
uniform vec3 sunColor;
uniform vec3 ambientLightIntensity;
uniform sampler2D objectTexture;
uniform sampler2D grassTexture;
uniform sampler2D rockTexture;
uniform sampler2D snowTexture;
uniform bool useTexture;
uniform bool useTerrainBlending;
uniform float blendHeight;
uniform float snowBlendHeight;
uniform vec3 fogColor;
uniform float fogNear;
uniform float fogFar;

uniform float objectAlpha;

in vec3 fragNormal;
in vec3 fragPos;
in vec3 worldPos;
in vec2 fragTexCoord;
in float fragHeight;
in float fogDistance;

out vec4 output_color;

// Simple noise function for varying snow line
float random(vec2 st) {
    return fract(sin(dot(st.xy, vec2(12.9898,78.233))) * 43758.5453123);
}

float noise(vec2 st) {
    vec2 i = floor(st);
    vec2 f = fract(st);
    
    float a = random(i);
    float b = random(i + vec2(1.0, 0.0));
    float c = random(i + vec2(0.0, 1.0));
    float d = random(i + vec2(1.0, 1.0));
    
    vec2 u = f * f * (3.0 - 2.0 * f);
    
    return mix(a, b, u.x) + (c - a)* u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
}

void main() {
    vec3 materialColor;
    
    if (useTerrainBlending) {
        vec3 grassColor = texture(grassTexture, fragTexCoord).rgb;
        vec3 rockColor = texture(rockTexture, fragTexCoord).rgb;
        vec3 snowColor = texture(snowTexture, fragTexCoord).rgb;
        
        float grassToRockFactor = smoothstep(blendHeight - 5.0, blendHeight + 5.0, fragHeight);
        vec3 grassRockBlend = mix(grassColor, rockColor, grassToRockFactor);
        
        vec2 noiseCoord = worldPos.xz * 0.1;
        float noiseValue = noise(noiseCoord) * 2.0 - 1.0;
        float randomizedSnowHeight = snowBlendHeight + noiseValue * 15.0;
        
        float rockToSnowFactor = smoothstep(randomizedSnowHeight - 5.0, randomizedSnowHeight + 5.0, fragHeight);
        materialColor = mix(grassRockBlend, snowColor, rockToSnowFactor);
    } else if (useTexture) {
        materialColor = texture(objectTexture, fragTexCoord).rgb;
    } else {
        materialColor = color;
    }
    
    vec3 finalColor;
    
    // Skip lighting calculations for transparent objects (clouds)
    if (objectAlpha < 1.0) {
        // For transparent objects, use bright material color without lighting
        finalColor = materialColor;
    } else {
        // For opaque objects, apply full lighting
        vec3 ambient = ambientLightIntensity * materialColor * 0.2;

        vec3 norm = normalize(fragNormal);
        vec3 lightDir = normalize(sunDirection); 
        float diff = max(dot(norm, lightDir), 0.0);
        vec3 diffuse = diff * sunColor * materialColor;
        
        vec3 viewDir = normalize(-fragPos);
        vec3 reflectDir = reflect(-lightDir, norm);
        float spec = pow(max(dot(viewDir, reflectDir), 0.0), 32.0);
        vec3 specular = spec * sunColor * 0.3;

        finalColor = ambient + diffuse;
    }
    
    float fogFactor = clamp((fogFar - fogDistance) / (fogFar - fogNear), 0.0, 1.0);
    finalColor = mix(fogColor, finalColor, fogFactor);

    output_color = vec4(finalColor, objectAlpha);
}
